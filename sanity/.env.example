# Studio only — copy to .env in this folder (sanity/)
# Use the SAME project ID as NEXT_PUBLIC_SANITY_PROJECT_ID in the repo root.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Required for `npm run seed` from repo root. Token must have write access (Editor or Developer), not Viewer-only.
# Create at sanity.io/manage → API → Tokens
SANITY_API_TOKEN=

# Presentation tool — local Next site for Visual Editing preview.
# SANITY_STUDIO_PREVIEW_URL=http://localhost:3000

