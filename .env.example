# ——— Sanity ↔ Next.js (repo root) ———
# 1. sanity.io/manage → your project → copy Project ID
# 2. Copy this file to .env.local (or run `npm run pull:vercel` and merge from `.vercel/.env.production.local`)
# 3. sanity/README.md has the full checklist (Studio + CORS)
#
# Refresh from cloud (no schema/code overwrite):
#   npm run pull:vercel  → .vercel/project.json + .vercel/.env.production.local
#   npm run pull:sanity  → sanity/backups/production-latest.ndjson

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Default: reads hit Sanity API (not the CDN) so published edits show quickly. Set "true" only if you need CDN edge caching.
# SANITY_API_USE_CDN=true

# Optional — call GET/POST /api/revalidate-sanity?secret=... after publishing (or wire as Sanity webhook) to clear Next’s Data Cache immediately.
# SANITY_REVALIDATE_SECRET=use-a-long-random-string

# Optional — canonical URL for sitemap, robots, JSON-LD, metadata (default: https://www.mynella.com in code)
# NEXT_PUBLIC_SITE_URL=https://www.mynella.com

# Legal PDFs: add files under public/legal/ — see public/legal/README.md. Sanity siteSettings legalTermsUrl / legalPrivacyUrl override /terms and /privacy with external URLs.

# Optional — GA4 measurement ID; leave empty to disable analytics in code.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ——— Resend (contact form + footer newsletter + blog gate) ———
# resend.com → API Keys. From must be a verified domain (e.g. updates@yourdomain.com).
# RESEND_LEAD_TO_EMAIL = inbox that receives contact inquiries and lead notifications.
# Footer + blog signups also send a welcome email TO the user (reply-to = RESEND_LEAD_TO_EMAIL).
# Book-a-call links come from Sanity siteChrome (fallback: seed Cal.com URLs). Site links use NEXT_PUBLIC_SITE_URL.
# RESEND_API_KEY=re_Y6Ghs4UY_WjbcJJzzpeJYqULrJYj6Q9GH
# RESEND_FROM_EMAIL=noreply@iamclearmind.com
# RESEND_LEAD_TO_EMAIL=admin@iamclearmind.com
#
# Optional — add form signups to a Resend Segment or (legacy) Audience. Sending email alone does not subscribe them.
# Dashboard → Audiences / Segments → copy ID. Prefer segment:
# RESEND_LEADS_SEGMENT_ID=
# Or legacy audience:
# RESEND_LEADS_AUDIENCE_ID=
#
# Contacts receive properties for segmentation: lead_source (footer | blog | contact), optional phone, product_interest (contact form).
# Define matching contact properties in the Resend dashboard if the API rejects unknown keys.
#
# Operational check (lists segments, sample contacts; optional create/remove probe): npm run ops:resend [--write-test]
