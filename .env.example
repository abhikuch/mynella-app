# ——— MyNella — Next.js (repo root) ———
# Copy to: .env.local (never commit .env.local)
# If Vercel ↔ Sanity integration auto-added vars in the dashboard, mirror them here for local dev.

# sanity.io/manage → MyNella project → Project ID + dataset name
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional — set "true" only if you want CDN reads (published content may lag slightly behind API).
# SANITY_API_USE_CDN=true

# Required for on-demand revalidation: long random string. Same value in Sanity webhook query:
#   https://www.<your-domain>/api/revalidate-sanity?secret=THIS_VALUE
SANITY_REVALIDATE_SECRET=

# Canonical site URL — no trailing slash (sitemap, robots, JSON-LD, OG defaults)
NEXT_PUBLIC_SITE_URL=https://www.mynella.com

# Optional — GA4 measurement ID; leave empty to disable
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ——— Resend (contact + newsletter) ———
# resend.com → API Keys. From address must use a verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_LEAD_TO_EMAIL=

# Optional — Resend Segments / Audiences for marketing properties
# RESEND_LEADS_SEGMENT_ID=
# RESEND_LEADS_AUDIENCE_ID=
